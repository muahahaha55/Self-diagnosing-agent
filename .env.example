# Copy to .env and fill in. .env is gitignored -- never commit real values.
# The backbone is served over an OpenAI-compatible HTTP endpoint (e.g. a local
# vLLM / SGLang server, or a hosted one). Only code/run_agent.py reads these;
# the probe, scoring, and regen scripts need none of them.

API_BASE=http://localhost:8000/v1
API_KEY=dummy
MODEL=Qwen3.5-9B

# Hugging Face token, needed only for GATED repos (meta-llama/*). Used to read
# the canonical chat template / tokenizer config and to pull weights for
# serving. Leave blank if you only use ungated models.
# Format: a token starting with hf_ -- paste it bare, no quotes.
HF_TOKEN=
